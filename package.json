{
  "name": "lite-foundation",
  "version": "1.1.1",
  "description": "Lightweight Foundation-compatible UI starter (Vite + Sass + optional Cash/Swiper/Animate.css).",
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "node scripts/build.js",
    "sync:features": "node scripts/sync-features.js",
    "lint:tokens": "node scripts/lint-tokens.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18.0"
  },
  "dependencies": {
    "animate.css": "^4.1.1",
    "cash-dom": "^8.1.5",
    "swiper": "^11.2.10"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.10",
    "happy-dom": "^20.11.1",
    "sass": "^1.79.3",
    "vite": "^6.0.0",
    "vitest": "^4.1.10"
  },
  "private": true,
  "browserslist": [
    "last 2 versions"
  ]
}
